[
  {
    "label": "CMake: 配置 (Configure)",
    "command": "cmake",
    "args": ["--preset", "linux-debug"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success",
    "allow_concurrent_runs": false
  },
  {
    "label": "CMake: 生成 (Build)",
    "command": "cmake",
    "args": ["--workflow", "--preset", "linux-debug"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success",
    "allow_concurrent_runs": false
  },
  {
    "label": "▶ 编译并运行",
    "command": "cmake",
    "args": ["--workflow", "--preset", "linux-debug-run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "reveal": "always",
    "hide": "on_success",
    "allow_concurrent_runs": false,
    "use_new_terminal": true
  },
  {
    "label": "▶ 运行 (不编译)",
    "command": "./NEXUS_EDITOR",
    "cwd": "$ZED_WORKTREE_ROOT/build/bin",
    "reveal": "always",
    "hide": "on_success",
    "allow_concurrent_runs": false,
    "use_new_terminal": true
  }
]
